---
import MethodDiagram from './MethodDiagram.astro';
import { t, toLang } from '../lib/i18n';

const s = t(toLang(Astro.currentLocale));

const bibtex = `@article{tuanmu2025genfocus,
  title   = {Generative Refocusing: Flexible Defocus Control from a Single Image},
  author  = {Tuan Mu, Chun-Wei and Fan, Cheng-De and Huang, Jia-Bin and Liu, Yu-Lun},
  journal = {arXiv preprint arXiv:2512.16923},
  year    = {2025}
}

@inproceedings{bochkovskii2025depthpro,
  title     = {Depth Pro: Sharp Monocular Metric Depth in Less Than a Second},
  author    = {Bochkovskii, Aleksei and Delaunoy, Ama{\\"e}l and Germain, Hugo and Santos, Marcel and
               Zhou, Yichao and Richter, Stephan R. and Koltun, Vladlen},
  booktitle = {International Conference on Learning Representations},
  year      = {2025}
}`;
---

<!-- 7. Método e créditos -->
<section class="wrap py-8" id="credits">
  <h2 class="section-title">{s.credits.title}</h2>
  <MethodDiagram />
  <p class="leading-relaxed" set:html={s.credits.body} />
  <h3 class="mt-6 mb-2 text-lg">BibTeX</h3>
  <pre class="overflow-x-auto rounded-md bg-[#f5f5f5] p-4 text-[0.8rem] leading-relaxed whitespace-pre-wrap break-words text-ink"><code class="bg-transparent p-0 text-inherit">{bibtex}</code></pre>
</section>

